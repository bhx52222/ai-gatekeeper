# Base image. This machine already has the previous verified Docker Claude Code
# image, so SafeRoom overlays checks and launchers on top of it.
BASE_IMAGE=local/claude-code-docker:latest

# Only used if you switch Dockerfile back to a full build later.
CLAUDE_CODE_VERSION=latest

# Host project directory mounted into /workspace inside the container.
WORKSPACE_DIR=./workspace

# Container identity. Keep this aligned with the target account/network profile.
DOCKER_TZ=America/Los_Angeles
DOCKER_LANG=en_US.UTF-8
DOCKER_LANGUAGE=en_US:en
DOCKER_LC_ALL=en_US.UTF-8

# Container DNS. These are container-level resolvers, separate from macOS DNS.
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8

# Host-side checks run on macOS. These defaults match Surge for Mac.
HOST_HTTP_PROXY=http://127.0.0.1:6152
HOST_HTTPS_PROXY=http://127.0.0.1:6152
HOST_ALL_PROXY=socks5h://127.0.0.1:6153

# Container-side checks reach the macOS proxy through host.docker.internal.
DOCKER_HTTP_PROXY=http://host.docker.internal:6152
DOCKER_HTTPS_PROXY=http://host.docker.internal:6152
DOCKER_ALL_PROXY=socks5h://host.docker.internal:6153
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal

# Expected AI egress. Leave empty until you have a known-good result.
TARGET_COUNTRY=US
EXPECTED_IP=
MIN_SCORE=85
TIMEOUT=20

# Existing host gate scripts from the "完美隐私" workflow.
PRIVACY_DIR=../scripts
